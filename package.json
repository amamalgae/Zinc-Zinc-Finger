    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.3.0",
    "h5wasm": "^0.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "8.2.0"
